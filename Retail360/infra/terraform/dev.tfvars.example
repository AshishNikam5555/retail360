# EXAMPLE - copy to dev.tfvars (git-ignored) and replace placeholders.
environment     = "dev"
subscription_id = "<your-subscription-id>"
tenant_id       = "<your-tenant-id>"
location        = "uksouth"

service_principal_application_id = "<your-sp-application-id>"
service_principal_object_id      = "<your-sp-object-id>"

storage_replication_type = "LRS"
soft_delete_days         = 7
landing_retention_days   = 30
eventhub_partition_count = 2
log_retention_days       = 30
